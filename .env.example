# Google Analytics 4 measurement ID (also used for gtag.js)
NEXT_PUBLIC_GA_ID=G-C7E3K3TSXV

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Firebase web config for nursia-io.
#
# These are not secrets — a web API key identifies the project and is visible
# in any browser that loads the site. What protects the data is the Firestore
# security rules in firestore.rules, not this file. They live in env anyway so
# a staging project is a config change rather than a code change.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to run against the local Firebase emulators (npx firebase emulators:start)
NEXT_PUBLIC_FIREBASE_EMULATORS=

# A service account for scripts/seed-questions.mjs, which mirrors the question
# bank into Firestore. THIS ONE IS A REAL SECRET — unlike everything above it,
# it grants full admin access to the project and bypasses the security rules.
# Keep it out of the repo and out of .env.local if you can; pass it in the
# environment of the one command that needs it. Either the JSON inline:
FIREBASE_SERVICE_ACCOUNT=
# ...or a path to the same file:
GOOGLE_APPLICATION_CREDENTIALS=

# Google Ads conversion tracking (account 6331825613 "nursia").
# Public by design — these ship to every browser that loads the page. They are
# in env for configurability, not secrecy. Created by
# tooling/google-ads-api/create_nursia_conversions.py in the NismReady repo.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18411895345
# "Signup" — PRIMARY, the conversion the campaign bids toward
NEXT_PUBLIC_ADS_SIGNUP_LABEL=AW-18411895345/SfHmCJ_ip-kcELH0vMtE
# "Question Answered" — SECONDARY, observation only
NEXT_PUBLIC_ADS_QUESTION_LABEL=AW-18411895345/EjOsCKLip-kcELH0vMtE

# Sanity — the CMS behind /guides and the topic pages.
#
# The project id and dataset are public by design; they are in every content
# request a browser makes and there is nothing to protect there. Both are
# REQUIRED to build: src/sanity/client.ts constructs the client at module load
# and throws without them, which reads as "Failed to collect page data".
#
# The tokens are the opposite. The write token belongs to the seeding pipeline
# — it can rewrite the entire content lake, so it should never be present in a
# browser build.
#
# The read token is not about permission: the dataset is public. It is about
# rate limiting. A build prerenders ~1,700 pages from one IP, and anonymous
# reads share a per-IP bucket that a build of this size exhausts (HTTP 429,
# `sanity-ratelimit-applied: ip`). Set it in CI and on Railway; without it the
# build still works, just closer to the limit.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Shared with the Sanity webhook that calls /api/revalidate, so an edit in the
# Studio reaches the live page in seconds rather than on the next deploy.
SANITY_REVALIDATE_SECRET=

# Meta pixel — dataset "NCLEX META SignUp" in Events Manager.
# Public by design, exactly like the Google Ads ids above: it ships to every
# browser that loads the page. Unset means no pixel at all, which is what you
# want in a staging build so test traffic never reaches Ads Manager.
NEXT_PUBLIC_META_PIXEL_ID=1446506794201326

# ─── Growth measurement sprint ───────────────────────────────────────────────
# PostHog, project NCLEX-Nursia (595036) — the system of record (NUR-05).
# The project token is public by design, like the GA4 and pixel ids above: an
# ingestion token cannot read anything back. Confirm it matches the token the
# app ships (C-11) or the funnel splits across two projects.
NEXT_PUBLIC_POSTHOG_KEY=phc_vKp8KEz9hNiqbJxMCgSWtdtX5d4AaBDowZUtTJMNQe29
# The same-origin proxy in next.config.ts, not the PostHog host.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# Share of sessions recorded by replay (NUR-29). Sampled, not 100%.
NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE_RATE=0.25

# Meta Conversions API (NUR-08). Server only — never NEXT_PUBLIC_. A system-user
# token for the dataset in NEXT_PUBLIC_META_PIXEL_ID; META_PIXEL_ID overrides
# that id for the server call if they ever need to differ.
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
# Dev only: routes server events to Events Manager → Test Events while verifying.
# MUST be unset in production.
META_TEST_EVENT_CODE=
# Origins allowed to call /api/meta/capi (the app sends registration from here).
CAPI_ALLOWED_ORIGINS=https://nursia.io,https://www.nursia.io,https://app.nursia.io

# Login on nursia.io (NUR-28). The app's Supabase project (nclex-prod). The anon
# key is public by design; row-level security is what protects the data. Unset,
# /login and /signup keep forwarding visitors to the app instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://app.nursia.io

# Google Ads API (NUR-30, P2 — optional). Revenue attribution has three routes
# that need none of this (NUR-24); apply only when upload volume justifies it.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=6331825613
# GOOGLE_ADS_PURCHASE_ACTION_ID=

# ─── Content and keyword pipelines (NUR-31) ──────────────────────────────────
# Read by pipeline/ and scripts/. None is needed to build or run the site. The
# defaults below are what the code falls back to when a variable is unset.
#
# SQLite working stores
CONTENT_DB=pipeline/data/content.db
NURSING_DB=pipeline/nursing/data/nursing.db
NCLEX_DB=pipeline/nclex/data/nclex.db
# Source question bank CSV for `npm run nclex:ingest`
NCLEX_CSV=
# Directory `npm run nursing:ingest` reads exports from (default ~/Downloads)
KW_DIR=
# Keyword Planner harvest (`npm run kw:ideas`): seed list and target geography
KW_SEEDS=pipeline/keywords/seeds.txt
KW_GEO=United States
# Google Trends: `dataset` (default) or `browser` source, a CSV when using a
# file, geography, the anchor term every series is scaled against, and for the
# browser source whether to run headless (1) and the pause between queries (ms)
TRENDS_SOURCE=dataset
TRENDS_CSV=
TRENDS_GEO=US
TRENDS_ANCHOR=nclex
TRENDS_HEADLESS=
TRENDS_PAUSE=6000
# Keyword Planner browser automation: Ads customer id, the persistent browser
# profile, where downloads land, and how long `npm run kw:signin` waits for a
# manual sign-in (minutes)
ADS_CUSTOMER=6331825613
ADS_BROWSER_PROFILE=pipeline/.browser-profile
ADS_DOWNLOAD_DIR=pipeline/data/downloads
SIGNIN_WAIT_MINUTES=6
