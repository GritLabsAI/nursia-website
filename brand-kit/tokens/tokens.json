{
  "$name": "Nursia — Flowsheet",
  "$description": "Design tokens for Nursia. Mirrors the @theme block in src/app/globals.css, which is the source of truth.",
  "$version": "1.1.0",
  "color": {
    "ground": {
      "paper": { "value": "#FBFAF6", "use": "Default background for every surface." },
      "paper-2": { "value": "#F4F2EB", "use": "Second surface — inset panels, quiet blocks, a picked answer row." },
      "white": { "value": "#FFFFFF", "use": "Cards only. Never a page background." }
    },
    "ink": {
      "ink": { "value": "#14161A", "use": "Headlines, wordmark, the one dark band per page." },
      "ink-2": { "value": "#3A3D44", "use": "Body copy." },
      "muted": { "value": "#6E6B63", "use": "Mono labels, eyebrows, captions. Never body copy." },
      "rule": { "value": "#E3DFD4", "use": "Hairlines and card borders. 1px only." }
    },
    "action": {
      "teal": { "value": "#0B6B62", "use": "Buttons, links, ticks, the logo's full stop." },
      "teal-dark": { "value": "#084F49", "use": "Hover and pressed state only." },
      "highlight": { "value": "#F5E85C", "use": "The highlighter stroke. One per surface." },
      "highlight-dark": { "value": "#EFE04A", "use": "Hover on the highlighter button." }
    },
    "state": {
      "correct": { "value": "#157F52", "use": "Correct answer border." },
      "correct-fill": { "value": "#F3FAF5", "use": "Correct answer fill." },
      "wrong": { "value": "#B23A2E", "use": "Wrong answer border; exam clock in its last five minutes." },
      "wrong-fill": { "value": "#FDF5F3", "use": "Wrong answer fill." }
    }
  },
  "font": {
    "display": { "value": "\"Bricolage Grotesque\", ui-sans-serif, system-ui, sans-serif", "weights": [600, 700, 800], "use": "Headlines and UI. Never body copy." },
    "body": { "value": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif", "weights": [400, 600], "use": "Sentences and rationales. Never headlines." },
    "mono": { "value": "\"IBM Plex Mono\", ui-monospace, Menlo, monospace", "weights": [400, 500, 600, 700], "use": "Numbers, eyebrows, labels, keys, IDs." }
  },
  "type": {
    "hero": { "font": "display", "weight": 800, "size": "clamp(38px, 5vw, 56px)", "leading": 1.06, "tracking": "-0.022em" },
    "section": { "font": "display", "weight": 700, "size": "25px", "leading": 1.1, "tracking": "-0.022em" },
    "subhead": { "font": "display", "weight": 600, "size": "18px", "leading": 1.25, "tracking": "-0.012em" },
    "body": { "font": "body", "weight": 400, "size": "17px", "leading": 1.72 },
    "body-sm": { "font": "body", "weight": 400, "size": "15px", "leading": 1.55 },
    "ui": { "font": "display", "weight": 600, "size": "15px", "tracking": "-0.01em" },
    "eyebrow": { "font": "mono", "weight": 500, "size": "11px", "tracking": "0.14em", "transform": "uppercase", "color": "muted" }
  },
  "space": {
    "tight": "8px",
    "inner": "16px",
    "card": "22px",
    "group": "44px",
    "band": "80px",
    "grid": "4px base — every value is a multiple of 4"
  },
  "layout": {
    "container": "1140px",
    "measure": "42rem",
    "tap-min": "44px",
    "card-max": "560px"
  },
  "shape": {
    "radius-card": "4px",
    "radius-control": "3px",
    "radius-chip": "2px",
    "border": "1px solid #E3DFD4",
    "shadow-card": "0 1px 0 rgba(20,22,26,0.04), 0 10px 24px -18px rgba(20,22,26,0.35)"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.7, 0.3, 1)",
    "state": "160ms",
    "reveal": "380ms",
    "swipe": "620ms",
    "reduced-motion": "All durations drop to 0.001ms; smooth scrolling is disabled."
  },
  "contrast": {
    "note": "WCAG ratios against paper #FBFAF6.",
    "ink": 17.34,
    "ink-2": 10.41,
    "teal": 6.1,
    "wrong": 5.68,
    "muted": 5.1,
    "correct": 4.8,
    "white-on-teal": 6.38,
    "paper-on-ink": 17.34,
    "ink-on-highlight": 14.3
  },
  "rules": [
    "No gradients.",
    "No shadow except the card's.",
    "No glow.",
    "No third accent colour.",
    "Teal and highlight never touch.",
    "Green and red are states, never decoration.",
    "One highlighter stroke per surface.",
    "One dark band per page.",
    "Borders are 1px. There is no 2px border."
  ]
}
